<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the Angular single-page application.

  Deploy the contents of frontend/lean-portal/dist/lean-portal/browser into the
  site root alongside this file (renamed to web.config).

  Requires the IIS URL Rewrite module:
  https://www.iis.net/downloads/microsoft/url-rewrite
-->
<configuration>
  <system.webServer>

    <!-- === routing === -->
    <rewrite>
      <rules>
        <!--
          Serve real files and folders as-is; send everything else to index.html
          so the Angular router can resolve the route on the client.
          /api is excluded so requests reach the API application.
        -->
        <!--
          Everything goes over TLS.

          Deploy-LeanPortal.ps1 takes this rule back out while the site has no
          HTTPS binding, because redirecting to a port nothing is listening on
          would take the site off the air. Enable-Https.ps1 puts it back once it
          has opened a TLS connection and seen the right certificate. So the rule
          lives here, in source control, and the scripts decide when it applies.

          localhost is left alone: the deployment health check runs against it
          before the host name resolves on the server itself.
        -->
        <rule name="HTTP to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^(localhost|127\.0\.0\.1)(:\d+)?$" negate="true" />
          </conditions>
          <!-- REQUEST_URI already carries the query string. -->
          <action type="Redirect" url="https://{HTTP_HOST}{REQUEST_URI}"
                  redirectType="Permanent" appendQueryString="false" />
        </rule>

        <!--
          The XML sitemap is generated by the API, which is a child application
          under /api. Without this a crawler asking the site root for the sitemap
          falls through to the rule below and is handed index.html.
        -->
        <rule name="Sitemap to API" stopProcessing="true">
          <match url="^sitemap\.xml$" />
          <action type="Redirect" url="/api/site/sitemap.xml" redirectType="Permanent" />
        </rule>

        <rule name="Angular routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(api|uploads|swagger|health)" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>

      <outboundRules>
        <!-- Do not advertise the server product or version. -->
        <rule name="Remove Server header">
          <match serverVariable="RESPONSE_Server" pattern=".+" />
          <action type="Rewrite" value="" />
        </rule>
      </outboundRules>
    </rewrite>

    <!-- === caching === -->
    <staticContent>
      <!-- Angular emits content-hashed file names, so these are safe to cache hard. -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />

      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

    <!-- === compression === -->
    <!--
      Only the switch lives here. Which types are compressed (httpCompression) is a
      server-wide section that IIS will not accept in a site's web.config: having
      it here failed every request with a 500.19. Setup-IIS.ps1 sets the types on
      the server instead.
    -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- === security === -->
    <httpProtocol>
      <!--
        Each header is removed before it is added. A server that already sets one
        of these for every site it hosts - which a shared server often does -
        would otherwise make this a duplicate entry, and IIS refuses the whole
        file with 500.19 rather than just ignoring the line.
      -->
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <remove name="Permissions-Policy" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=()" />
        <!--
          HSTS, deliberately short to begin with.

          A browser that has seen this header will not let a visitor through to
          the site over plain HTTP, and will not let them click past a
          certificate warning, for the whole of max-age. That is the point of it,
          and it is also why a year is the wrong number on the first day: one
          lapsed renewal and the site is unreachable for everyone who has
          visited, with nothing the visitor can do.

          One day now. Raise it to 31536000 (a year) here, and redeploy, once a
          renewal has been through the cycle successfully. Only consider preload
          after that, and note it cannot be undone quickly.

          Browsers ignore this header over plain HTTP, so it has been inert until
          now; it takes effect the moment 443 answers.
        -->
        <remove name="Strict-Transport-Security" />
        <add name="Strict-Transport-Security" value="max-age=86400; includeSubDomains" />
        <!--
          Content Security Policy.
          script-src carries no 'unsafe-inline'. The Bhashini translation plugin
          is allow-listed explicitly: it loads its script and stylesheet from
          translation-plugin.bhashini.co.in and calls the Bhashini translation
          API, so blocking those would leave the language selector inert.
          frame-src allows 'self', for the sandboxed page an integration's embed
          code runs in, and any https address - the gallery's YouTube and Vimeo
          films, the office map, the agencies' hosted forms, and whatever page the
          console sets certificate verification or the certified-units list to
          show in a frame. A frame cannot script the page around it, and every
          address framed here is set in the console, not by a visitor.
          'unsafe-inline' stays on style-src only because Angular injects component
          styles at runtime; no font or stylesheet host is allowed any more, as the
          fonts are served from this origin.
        -->
        <remove name="Content-Security-Policy" />
        <add name="Content-Security-Policy"
             value="default-src 'self'; script-src 'self' https://translation-plugin.bhashini.co.in; style-src 'self' 'unsafe-inline' https://translation-plugin.bhashini.co.in; font-src 'self' data:; img-src 'self' data: https:; frame-src 'self' https:; connect-src 'self' https://translation-plugin.bhashini.co.in https://bhashini.gov.in https://*.bhashini.co.in; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering removeServerHeader="true">
        <!-- 30 MB, matching the API upload limit. -->
        <requestLimits maxAllowedContentLength="31457280" />
        <hiddenSegments>
          <remove segment="node_modules" />
          <add segment="node_modules" />
          <remove segment=".angular" />
          <add segment=".angular" />
        </hiddenSegments>
        <!-- IIS blocks .config for every site by default, so this one is always a
             duplicate unless it is removed first. -->
        <fileExtensions allowUnlisted="true">
          <remove fileExtension=".config" />
          <add fileExtension=".config" allowed="false" />
          <remove fileExtension=".ts" />
          <add fileExtension=".ts" allowed="false" />
          <remove fileExtension=".scss" />
          <add fileExtension=".scss" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <!-- === error pages === -->
    <httpErrors errorMode="Custom" existingResponse="Auto">
      <remove statusCode="404" />
      <error statusCode="404" path="/index.html" responseMode="ExecuteURL" />
    </httpErrors>

  </system.webServer>

  <!--
    location has to sit here, directly under configuration. It was written inside
    system.webServer, where IIS does not recognise it and refuses the whole file
    with a 500.19 - so every request to the site failed, not just index.html.
  -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <!-- The entry document must never be cached, or a deploy will not take effect. -->
        <clientCache cacheControlMode="DisableCache" />
        <!-- index.html is served from this location; no collection entries here. -->
      </staticContent>
    </system.webServer>
  </location>

  <!--
    The page an integration's embed code runs in (certificate verification,
    certified units, the assistant). The API serves it with a policy of its own,
    loose enough for the provider's scripts, and the portal only ever shows it in a
    sandboxed frame with an origin of its own, where those scripts can reach
    nothing of the portal's. The site-wide policy above would be added to it and
    block exactly those scripts, so it is taken off here - for this path alone.
  -->
  <location path="api/site/integrations">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <remove name="Content-Security-Policy" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
