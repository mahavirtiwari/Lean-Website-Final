{
  "Smtp": {
    "//": "Leave Host empty to keep e-mail suppressed and only logged. With it set, enquiries are sent to the agency the visitor chose. Put the password in machine configuration or an environment variable, never here.",
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "User": "",
    "Password": "",
    "FromAddress": "no-reply@lean.msme.gov.in",
    "FromName": "MSME Competitive (LEAN) Scheme",
    "CopyTo": ""
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=LeanPortal;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },

  "Jwt": {
    "Issuer": "LeanPortal",
    "Audience": "LeanPortalAdmin",
    "Key": "",
    "AccessTokenMinutes": 15,
    "SessionIdleMinutes": 30
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "https://localhost:4200" ]
  },

  "Database": {
    "MigrateAndSeedOnStartup": true,
    "EnableDetailedErrors": false,
    "EnableSensitiveLogging": false
  },

  "FileStorage": {
    "RootPath": "",
    "RequestPath": "/uploads",
    "MaxImageBytes": 5242880,
    "MaxDocumentBytes": 26214400
  },

  "RateLimiting": {
    "PublicPerMinute": 600,
    "FormsPerMinute": 5,
    "LoginPerMinute": 8,
    "CaptchaPerMinute": 30
  },

  "Seed": {
    "AdminEmail": "admin@lean.msme.gov.in",
    "AdminPassword": ""
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/lean-portal-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },

  "AllowedHosts": "*"
}
